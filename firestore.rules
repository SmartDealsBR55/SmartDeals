rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && exists(/databases/$(database)/documents/administradores/$(request.auth.uid))
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.ativo == true;
    }
    function owner() { return signedIn() && resource.data.get('ownerId', '') == request.auth.uid; }
    function imageValid(value) {
      return value is string && value.size() <= 180000
        && (value.matches('https://.*') || value.matches('data:image/(jpeg|png|webp|avif);base64,[A-Za-z0-9+/=]+'));
    }
    function validProduct() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome','loja','categoria','precoAntigo','precoAtual','parcelas','avaliacao','economia','score','badge','imagens','imagem','link','expiraEm','excluirEm','ownerId','criadoEm','atualizadoEm'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 500
        && d.loja is string && d.loja.size() <= 100
        && d.categoria is string && d.categoria.size() <= 100
        && d.link is string && d.link.size() <= 4096 && d.link.matches('https://.*')
        && d.imagens is list && d.imagens.size() > 0 && d.imagens.size() <= 4
        && imageValid(d.imagens[0])
        && (d.imagens.size() < 2 || imageValid(d.imagens[1]))
        && (d.imagens.size() < 3 || imageValid(d.imagens[2]))
        && (d.imagens.size() < 4 || imageValid(d.imagens[3]))
        && d.imagem == d.imagens[0]
        && (d.expiraEm == null || d.expiraEm is timestamp)
        && (d.excluirEm == null || d.excluirEm is timestamp)
        && d.atualizadoEm == request.time;
    }
    function debitFor(id) {
      let before = get(/databases/$(database)/documents/carteiras/$(request.auth.uid)).data;
      let after = getAfter(/databases/$(database)/documents/carteiras/$(request.auth.uid)).data;
      return before.saldo >= 1 && after.saldo == before.saldo - 1 && after.ultimoProduto == id;
    }
    match /carteiras/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, delete: if false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saldo','ultimoProduto'])
        && request.resource.data.saldo is int && resource.data.saldo >= 1
        && request.resource.data.saldo == resource.data.saldo - 1
        && request.resource.data.ultimoProduto is string
        && !exists(/databases/$(database)/documents/produtos/$(request.resource.data.ultimoProduto))
        && getAfter(/databases/$(database)/documents/produtos/$(request.resource.data.ultimoProduto)).data.ownerId == uid;
    }
    match /administradores/{uid} {
      // Criar administradores somente no console Firebase ou Admin SDK.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /produtos/{id} {
      allow read: if true;
      allow create: if signedIn() && validProduct()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && (admin() || debitFor(id));
      allow update: if (admin() || owner())
        && (admin() || validProduct())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'criadoEm']);
      allow delete: if admin() || owner();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
